+class PausingRequestedIdReadJsonRepository(JsonPagePreloadRepository):
+    def __init__(
+        self,
+        path: Path,
+        requested_read_seen: threading.Event,
+        continue_submit: threading.Event,
+    ) -> None:
+        super().__init__(path)
+        self._requested_read_seen = requested_read_seen
+        self._continue_submit = continue_submit
+        self._pause_once = True
+
+    def get_by_id(self, user_id: str, preload_id: str):
+        record = super().get_by_id(user_id, preload_id)
+        if self._pause_once:
+            self._pause_once = False
+            self._requested_read_seen.set()
+            if not self._continue_submit.wait(timeout=2):
+                raise TimeoutError("Test did not release the delayed shadow submitter")
+        return record
 
 
