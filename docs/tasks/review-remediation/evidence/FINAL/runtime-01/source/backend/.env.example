# Copy this file to .env and fill in the values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Tokenizer used for source-token preflight estimation.
OPENAI_TOKEN_ENCODING=o200k_base
# Configure these together for OPENAI_MODEL. Pricing has no implicit default
# so an unknown or unpriced model fails closed instead of being treated as free.
OPENAI_RATE_CARD_VERSION=
OPENAI_MODEL_INPUT_MICRO_USD_PER_MILLION=
OPENAI_MODEL_OUTPUT_MICRO_USD_PER_MILLION=
# Total input-plus-maximum-output envelope. Valid range: 1..1000000.
OPENAI_MAX_INPUT_TOKENS_PER_CALL=128000
# Split-agent fallback turns per chunk. Valid range: 1..8.
MAX_SENTENCE_SPLIT_AGENT_TURNS=2
# Atomic usage reservations are additive and off by default during rollout.
USAGE_RESERVATION_ENABLED=false
USAGE_RESERVATION_TTL_SECONDS=900
# Synchronous replay records expire lazily. The byte ceiling is clamped below
# DynamoDB's 400 KB item limit.
SYNC_RESULT_TTL_SECONDS=86400
SYNC_RESULT_MAX_BYTES=65536
# JSON repositories remove at most this many expired replay records per
# repository operation. DynamoDB deployments should enable native TTL on the
# numeric `expires_at_epoch` attribute.
SYNC_RESULT_CLEANUP_BATCH_SIZE=100
# Execution claims are renewed while a synchronous provider request runs.
SYNC_EXECUTION_LEASE_SECONDS=120
SYNC_EXECUTION_WAIT_SECONDS=2
# Async preload ownership lease; renewed while the worker is active.
PRELOAD_WORKER_LEASE_SECONDS=900
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:18765,http://127.0.0.1:18765
MAX_SENTENCES=200
# Process-wide cap on concurrent OpenAI calls (analysis batches / split chunks).
OPENAI_MAX_CONCURRENT_CALLS=5
# Bounded local preload executor (running workers plus queued jobs).
INLINE_JOB_MAX_WORKERS=2
INLINE_JOB_QUEUE_CAPACITY=16
# Serialized preload documents are rejected above this ceiling (max 380000).
DYNAMODB_PRELOAD_MAX_BYTES=350000
# Article vocabulary list size = pool_size * (percent / 100). Default 8% ≈ former 15–25 items on typical news articles.
VOCABULARY_COVERAGE_PERCENT=8

# Storage backend: json (default) or dynamodb
STORAGE_BACKEND=json
# Enable the local admin runtime. Admin mode requires STORAGE_BACKEND=json.
ADMIN_ENABLED=false
# Comma-separated email addresses allowed to use the local admin UI.
ADMIN_EMAILS=
# Browser origin allowed to access the local admin API when admin mode is enabled.
ADMIN_ALLOWED_ORIGIN=http://localhost:3000
READING_ASSISTANT_DYNAMODB_TABLE_NAME=english-local-reading-assistant
DYNAMODB_ENDPOINT=http://localhost:18000
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# Start DynamoDB Local and the API together with:
# ./dev.sh
# Run the fixture-managed local DynamoDB integration tests from the repository root:
# task test:backend:integration:local

# Transient store for a preloaded article's raw extracted text (submit -> worker
# handoff, kept out of the DynamoDB record). Independent of STORAGE_BACKEND: set
# PRELOAD_CONTENT_BUCKET to use S3, otherwise a filesystem store writes under
# PRELOAD_CONTENT_DIR (default data/preload_content).
PRELOAD_CONTENT_BUCKET=
# PRELOAD_CONTENT_DIR=

# Identity provider for sign-in: mock (default, local development) or google.
# With google, install `pip install google-auth requests` and set the OAuth
# client id below.
AUTH_PROVIDER=mock
GOOGLE_OAUTH_CLIENT_ID=
# AUTH_SESSION_TTL_DAYS=30

# Billing provider for subscriptions: mock (default, plans switch instantly
# without payment) or stripe (hosted Checkout + Customer Portal + webhooks).
# With stripe, install `pip install stripe`, create two recurring prices in
# the Stripe dashboard (or via the CLI), and run the webhook forwarder
# locally: stripe listen --forward-to localhost:18765/billing/webhook
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAX=

# Launch plan limits (environment-overridable; see docs/BILLING.md).
# PLAN_BASIC_ARTICLES_PER_MONTH=3
# PLAN_BASIC_CHATS_PER_MONTH=15
# PLAN_BASIC_SENTENCES_PER_ARTICLE=50
# PLAN_BASIC_SOURCE_TOKENS_PER_ARTICLE=12000
# PLAN_BASIC_COST_MICRO_USD_PER_MONTH=200000
# PLAN_BASIC_TOKENS_PER_MONTH=200000
# PLAN_PRO_ARTICLES_PER_MONTH=40
# PLAN_PRO_CHATS_PER_MONTH=400
# PLAN_PRO_SENTENCES_PER_ARTICLE=150
# PLAN_PRO_SOURCE_TOKENS_PER_ARTICLE=36000
# PLAN_PRO_COST_MICRO_USD_PER_MONTH=2500000
# PLAN_PRO_TOKENS_PER_MONTH=3000000
# PLAN_MAX_ARTICLES_PER_MONTH=120
# PLAN_MAX_CHATS_PER_MONTH=1200
# PLAN_MAX_SENTENCES_PER_ARTICLE=300
# PLAN_MAX_SOURCE_TOKENS_PER_ARTICLE=72000
# PLAN_MAX_COST_MICRO_USD_PER_MONTH=7000000
# PLAN_MAX_TOKENS_PER_MONTH=10000000
