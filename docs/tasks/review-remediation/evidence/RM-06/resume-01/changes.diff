+        gate_scripts = re.findall(
+            r"(?ms)^      - name: Gate .*?^        run: \|\n(.*?)(?=^      - |\Z)",
+            workflow,
+        )
+        assert gate_scripts
+        assert all("${{" not in script for script in gate_scripts)
