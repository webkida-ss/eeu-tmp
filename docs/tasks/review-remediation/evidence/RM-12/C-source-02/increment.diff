+    snapshot["usage_complete"] = complete
+    if complete:
+        snapshot["actual_cost_micro_usd"] = int(snapshot["cost_micro_usd"])
+    else:
+        snapshot["actual_cost_micro_usd"] = max(
+            int(snapshot["cost_micro_usd"]),
+            int(operation.reserved_cost_micro_usd),
+        )
     return snapshot
 
 
