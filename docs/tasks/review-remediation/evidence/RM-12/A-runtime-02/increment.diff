+            return original_prepare(
+                content,
+                sentence_limit=sentence_limit,
+                source_token_limit=source_token_limit,
+            )
+
+        def estimate(prepared, **kwargs):
+            estimate_limits.append((prepared.sentence_limit, prepared.source_token_limit))
+            return original_estimate(prepared, **kwargs)
+
+        def submit_loser() -> None:
+            try:
+                submit_result["response"] = reading.submit_preload(
