+    def test_reserve_race_rebuilds_preload_using_the_winning_operation_allowance(self):
+        lower = PlanLimits("basic", 10, 10, 1, 100, 1_000, 200_000)
+        upgraded = PlanLimits("basic", 10, 10, 3, 200, 1_000, 200_000)
+        winner = UsageMeter(
