+            plan_loader=lambda _: upgraded,
+        )
+        reserve_started = threading.Event()
+        resume_reserve = threading.Event()
+
+        class PausingMeter(UsageMeter):
+            def reserve(self, *args, **kwargs):
+                reserve_started.set()
+                if not resume_reserve.wait(timeout=1):
+                    raise AssertionError("winner reservation did not complete")
+                return super().reserve(*args, **kwargs)
+
+        loser = PausingMeter(
+            self.subs,
+            self.usage,
+            "u1",
+            now=datetime(2026, 8, 1, 0, 10, tzinfo=UTC),
+            plan_loader=lambda _: lower,
