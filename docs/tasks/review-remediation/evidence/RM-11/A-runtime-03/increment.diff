+def _run_worker_process(
+    worker: Callable[[], int],
+    ready: Any,
+    release: Any,
+    outcomes: Any,
+) -> None:
+    ready.set()
+    if not release.wait(timeout=2):
+        outcomes.put(("error", "test coordinator did not release the worker"))
+        return
