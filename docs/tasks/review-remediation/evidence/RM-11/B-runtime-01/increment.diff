+                learner_profile_fingerprint,
+                lease_id=lease_id,
+                now=now,
+                lease_expires_at=now
+                + timedelta(seconds=max(1, int(os.getenv("PRELOAD_WORKER_LEASE_SECONDS", "900")))),
+            )
+            or record
+        )
+        if record.get("status") != "running" or record.get("lease_id") != lease_id:
+            return
