+    """Fail old in-flight shadow records rather than inventing accounting evidence."""
+    status = str(record.get("status") or "")
+    lease_id: str | None = None
+    if status == "running":
+        now = datetime.now(UTC)
+        if not _has_expired_preload_lease(record, now):
