+        user_id,
+        preload_id,
+        learner_profile_fingerprint,
+        failed,
+        lease_id=lease_id,
+        expected_status=status,
+    ):
+        _retire_terminal_content(
+            repository,
+            content_store,
+            user_id,
+            failed,
+            learner_profile_fingerprint,
