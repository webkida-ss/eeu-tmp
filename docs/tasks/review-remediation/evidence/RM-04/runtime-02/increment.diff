+test('panel selection does not overwrite a different preload stored for the same page', async () => {
+  const owner = { userId: 'account-a', loginId: 'login-a' };
+  const pageUrl = 'https://example.test/article';
+  const previousPreload = {
+    id: 'preload-previous',
+    page_url: pageUrl,
+    sentences: [{ id: 'sentence-previous', index: 0, text: 'Previous sentence.', analysis: {} }],
+  };
+  const mountedPreload = {
+    id: 'preload-current',
+    page_url: pageUrl,
+    sentences: [{ id: 'sentence-current', index: 0, text: 'Current sentence.', analysis: {} }],
+  };
+  const { context, dom, local } = createPanel({
+    storage: {
+      authSession: {
+        accessToken: 'account-a-token',
+        user: { id: owner.userId },
+        loginId: owner.loginId,
+      },
+    },
+  });
+  const key = context.readingSessionStorageKey(pageUrl, owner);
+  const previousSession = session({ owner, pageUrl, preload: previousPreload });
+  await context.chrome.storage.local.set({ [key]: previousSession });
+
+  try {
+    assert.equal(
+      await context.window.ReadingPanel.mountFromPreload(mountedPreload, pageUrl, 'Article', owner),
+      true,
+    );
+    context.document
+      .querySelector('.era-sentence-button[data-sentence-id="sentence-current"]')
+      .click();
+    await settle();
+
+    assert.deepEqual(local[key], previousSession);
+    assert.equal(context.window.ReadingPanel.isLocalUiPersistence(local[key]), false);
+  } finally {
+    dom.window.close();
+  }
+});
