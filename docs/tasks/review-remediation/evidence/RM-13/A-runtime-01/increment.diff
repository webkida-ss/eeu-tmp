+def _conditional_put(
+    table_name: str,
+    partition_key: str,
+    sort_key: str,
+    document: dict[str, Any],
+) -> dict[str, Any]:
+    item = {
+        "pk": partition_key,
+        "sk": sort_key,
+        DOCUMENT_ATTRIBUTE: json.dumps(document, ensure_ascii=False, separators=(",", ":")),
+    }
+    return {
+        "Put": {
+            "TableName": table_name,
+            "Item": {field: _SERIALIZER.serialize(value) for field, value in item.items()},
+            "ConditionExpression": "attribute_not_exists(pk) AND attribute_not_exists(sk)",
+        }
+    }
+
+
+def _is_conditional_identity_conflict(exc: ClientError) -> bool:
+    if exc.response.get("Error", {}).get("Code") != "TransactionCanceledException":
+        return False
+    reasons = exc.response.get("CancellationReasons")
+    if not isinstance(reasons, list) or not reasons:
+        return False
+    reason_codes = {reason.get("Code") for reason in reasons if isinstance(reason, dict)}
+    return (
+        reason_codes <= {"None", "ConditionalCheckFailed"}
+        and "ConditionalCheckFailed" in reason_codes
+    )
