google_client_id     = "replace-with-google-oauth-client-id"
google_client_secret = "replace-with-google-oauth-client-secret"

auth_callback_urls = [
  "http://localhost:13000/auth/callback",
]

auth_logout_urls = [
  "http://localhost:13000/auth/logout",
]

# Optional. Must be unique in the AWS region.
# cognito_domain_prefix = "vicente-calderon-dev-auth"
