{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/download/v14.0.1/permissions-schema.json",
  "permission": {
    "read": {
      ".env": "deny",
      "**/.env": "deny",
      ".env.local": "deny",
      "**/.env.local": "deny",
      ".env.development.local": "deny",
      "**/.env.development.local": "deny",
      ".env.test.local": "deny",
      "**/.env.test.local": "deny",
      ".env.production.local": "deny",
      "**/.env.production.local": "deny",
      "credentials/**": "deny",
      "**/credentials/**": "deny",
      ".aws/**": "deny",
      "**/.aws/**": "deny",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      ".config/gcloud/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.crt": "deny",
      "**/*.cer": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.*": "deny",
      "**/*.tfvars": "deny"
    }
  }
}
